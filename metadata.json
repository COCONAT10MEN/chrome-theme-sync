{
  "id": "chrome-theme-sync",
  "name": "Chrome Theme Sync",
  "description": "Makes Chrome, Chromium and Brave use your Caelestia colour scheme, and updates them when the scheme changes.",
  "icon": "icon.svg",
  "version": "1.0.0",
  "repository": "https://github.com/COCONAT10MEN/chrome-theme-sync",
  "caelestiaTested": "2.7.6",
  "type": "quickshell",
  "ui": "main.qml",
  "settings": [
    {
      "id": "colour",
      "label": "Browser colour",
      "type": "enum",
      "options": [
        "Background",
        "Accent"
      ],
      "default": "Background"
    }
  ],
  "author": {
    "name": "COCONAT10MEN",
    "url": "https://github.com/COCONAT10MEN"
  },
  "license": "MIT",
  "keywords": [
    "chrome",
    "chromium",
    "brave",
    "browser",
    "theme",
    "colours"
  ]
}
