  "type": "quickshell",
  "ui": "main.qml",
  "settings": [
    {
      "id": "colour",
      "label": "Browser colour",
      "type": "enum",
      "options": ["Background", "Accent"],
      "default": "Background"
    }
  ],
  "author": {
    "name": "COCONAT10MEN",
